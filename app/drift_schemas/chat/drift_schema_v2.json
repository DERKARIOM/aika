  "fixed_sql": [
    {
      "name": "chat_conversations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chat_conversations\" (\"peer_fingerprint\" TEXT NOT NULL, \"peer_alias\" TEXT NOT NULL, \"peer_device_model\" TEXT NULL, \"last_seen_at\" INTEGER NULL, \"unread_count\" INTEGER NOT NULL DEFAULT 0, \"last_message_preview\" TEXT NULL, \"last_message_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"peer_chat_protocol\" INTEGER NULL, PRIMARY KEY (\"peer_fingerprint\"));"
        }
      ]
    },
    {
      "name": "chat_messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chat_messages\" (\"id\" TEXT NOT NULL, \"conversation_id\" TEXT NOT NULL REFERENCES chat_conversations (peer_fingerprint), \"direction\" TEXT NOT NULL, \"content_type\" TEXT NOT NULL, \"body\" TEXT NULL, \"attachment_path\" TEXT NULL, \"attachment_file_name\" TEXT NULL, \"attachment_size\" INTEGER NULL, \"status\" TEXT NOT NULL, \"error_message\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"sent_at\" INTEGER NULL, \"delivered_at\" INTEGER NULL, \"read_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "chat_outbox_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chat_outbox_entries\" (\"message_id\" TEXT NOT NULL REFERENCES chat_messages (id), \"attempts\" INTEGER NOT NULL DEFAULT 0, \"next_attempt_at\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"message_id\"));"
        }
      ]
    },
    {
      "name": "chat_blocked_devices",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chat_blocked_devices\" (\"fingerprint\" TEXT NOT NULL, \"alias\" TEXT NOT NULL, \"blocked_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"fingerprint\"));"
        }
      ]
    },
    {
      "name": "chat_messages_conversation_created",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX chat_messages_conversation_created ON chat_messages (conversation_id, created_at)"
        }
      ]
    },
    {
      "name": "chat_outbox_next_attempt",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX chat_outbox_next_attempt ON chat_outbox_entries (next_attempt_at)"
        }
      ]
    }
